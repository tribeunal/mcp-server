# Dependencies
node_modules/

# Build output
dist/
*.js
*.js.map
*.d.ts
*.d.ts.map

# ...except skill helper scripts, which are shipped source, not build output.
!skills/**/scripts/*.js

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/

# Worker
worker/.dev.vars
worker/.wrangler/

# Local editor / agent config. `.mcp.json` is this repo's own dev MCP set
# (it hardcodes an absolute worker path); the repo root is also the plugin
# root, so a tracked copy would install those servers for every plugin user.
.claude/
.mcp.json
